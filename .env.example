# Copy this file to .env and fill in what you need. Never commit .env.

# Image clean-up (npm run images:clean). Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: which OpenAI image model to use, and quality (low, medium, high)
# IMAGE_MODEL=gpt-image-1
# IMAGE_QUALITY=medium

# Party mode host phones (see docs/PARTY_HOST.md). From Supabase › Project Settings › API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
